# ─────────────────────────────────────────────────────────────────────────────
# BAMOE Hiring Demo — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is git-ignored.  NEVER commit the .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── BAMOE container image versions ───────────────────────────────────────────
PROJECT_VERSION=9.3.1-ibm-0006
MANAGEMENT_CONSOLE_IMAGE=quay.io/bamoe/management-console:9.3.1-ibm-0006

# ── ADK server URL (used by the AI-Prescreen BPMN service task) ──────────────
# When running Docker/Podman on macOS the BAMOE containers reach the host via
# host.docker.internal.  On Linux use host-gateway or your host IP.
AI_PRESCREEN_URL=http://host.docker.internal:4321

# ── BAMOE base URLs (used by ADK tools running inside the Lima VM) ────────────
# host.lima.internal resolves to the macOS host from inside the Lima guest.
# On Linux replace with your host IP (e.g. 172.17.0.1).
BAMOE_BASE_URL=http://host.lima.internal:18081
AI_BAMOE_BASE_URL=http://host.lima.internal:18080

# ── watsonx Orchestrate ADK (Developer Edition) credentials ──────────────────
# The values below are the IBM-published defaults that ship with every fresh
# watsonx Orchestrate Developer Edition installation — they are documented in
# the official IBM Developer Edition Quick Start guide and are not personal
# credentials.  If you customised your local installation, change them here.
# See: https://www.ibm.com/docs/en/watsonx/watson-orchestrate/current?topic=edition-deploying-developer
ADK_AUTH_USERNAME=wxo.archer@ibm.com
ADK_AUTH_PASSWORD=watsonx
ADK_TENANT_NAME=wxo-dev

# ── PostgreSQL / pgAdmin (docker-compose) ─────────────────────────────────────
# Demo-only passwords for the local Docker development database.
# CHANGE these before any non-local or shared deployment.
POSTGRES_PASSWORD=postgres
KIE_DB_PASSWORD=kie-pass
PGADMIN_DEFAULT_PASSWORD=pass

# ── watsonx Orchestrate SaaS (only needed for cloud deployments) ──────────────
# Leave blank for local Developer Edition.
WO_INSTANCE=
WO_API_KEY=
