    <bpmn2:scriptTask id="_8B62D3CA-5D03-4B2B-832B-126469288BB4" name="New Hiring" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue>New Hiring</drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_9EAFE6C1-69B4-4908-B764-EF3C4A55BEE3</bpmn2:incoming>
      <bpmn2:outgoing>_SF_NH_TO_AI</bpmn2:outgoing>
      <bpmn2:script>System.out.println(&quot;New Hiring has been created for candidate: &quot; + candidate.getFullName());

kcontext.setVariable(&quot;hr_approval&quot;, false);
kcontext.setVariable(&quot;it_approval&quot;, false);

System.out.println(&quot;AI Prescreen (agentic) will run for candidate &quot; + candidate.getFullName());</bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="_D1060AB3-6C3E-4315-A0BE-CB9328EE505C" name="Application approved" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue>Application approved</drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_26035DE5-18F2-4B5D-9A03-E058B8928229</bpmn2:incoming>
      <bpmn2:outgoing>_0607C51D-198C-40FD-A599-A65E7B66F300</bpmn2:outgoing>
      <bpmn2:script>System.out.println(&quot;###################################&quot;);
System.out.println(&quot;Candidate &quot; + candidate.getFullName() + &quot; meet the requirements for the position, and was approved by HR and IT!&quot;);
System.out.println(&quot;###################################&quot;);
</bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="_FC9F6C75-5C47-414C-9A27-53B104C4329B" name="Application denied" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue>Application denied</drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_9FCBEBF9-BC54-40B7-BAC3-F4D17F34D9F8</bpmn2:incoming>
      <bpmn2:outgoing>_EC8D8528-F94A-4821-9489-A17332EC6028</bpmn2:outgoing>
      <bpmn2:script>System.out.println(&quot;###################################&quot;);
System.out.println(&quot;Candidate &quot; + candidate.getFullName() + &quot; don&apos;t meet the requirements for the position but we&apos;ll keep it on records for the future!&quot;);
System.out.println(&quot;###################################&quot;);
</bpmn2:script>
    </bpmn2:scriptTask>
